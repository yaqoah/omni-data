###############################################################################
# MULTI-STAGE DOCKERFILE FOR DJANGO BACKEND
#
# Stages:
# 1. Builder: Install Python deps (cached layer)
# 2. Runtime: Minimal image with only runtime deps
#
# Security:
# - Non-root user for container execution
# - Slim base image to reduce attack surface
# - No pip cache or build artifacts in final image
###############################################################################

# Stage 1: Builder
FROM python:3.11-slim as builder

WORKDIR /build

# Install system dependencies for building Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    postgresql-client-15 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python deps
COPY requirements.txt .
RUN pip install --user --no-cache-dir -r requirements.txt

# Stage 2: Runtime
FROM python:3.11-slim

WORKDIR /app

# Install runtime-only system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client-15 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 django && \
    mkdir -p /app/logs && \
    chown -R django:django /app

# Copy Python packages from builder
COPY --from=builder /root/.local /home/django/.local

# Copy application code
COPY . .

# Set environment
ENV PATH=/home/django/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Switch to non-root user
USER django

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/health/')" || exit 1

# Collect static files and run migrations
RUN python manage.py collectstatic --noinput

# Expose port
EXPOSE 8000

# Run gunicorn
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", \
     "--workers", "4", "--threads", "2", "--worker-class", "sync", \
     "--access-logfile", "-", "--error-logfile", "-"]